# HAUNT THE ROOM environment. Copy to .env (git-ignored); dev.sh exports it to every process, the server reads it.
# Optional values stay commented out: an empty DURABLE_ACTORS_* value breaks the actor client.

# Presenter routes (/api/presenter/*, /api/stage/grant, /api/relay/observer, bot joins) need this header value:
# x-presenter-token: <PRESENTER_TOKEN>. Generate one: openssl rand -hex 16
PRESENTER_TOKEN=

# QR target when not using `./dev.sh tunnel` (which writes logs/public-url, and that wins).
# PUBLIC_URL=https://example.trycloudflare.com

# --- LLM, voices, art (OpenAI). Unset: `claude -p --model haiku` for text, placeholders for media. ---
# OPENAI_API_KEY=

# --- Agent Relay (server + hunters share one workspace) ---
RELAY_BASE_URL=http://localhost:8787
# Unset: the coven creates a workspace and writes coven/.relay-key; the server reads that file.
# RELAY_WORKSPACE_KEY=rk_live_...

# --- Actors (local `durable-actors dev`; dev.sh sets the control plane to http://127.0.0.1:${ACTORS_PORT:-7300}) ---
# DURABLE_ACTORS_CONTROL_PLANE_URL=http://127.0.0.1:7300
# Hosted Terse only: project id + secret (the generated client reads these names).
# DURABLE_ACTORS_PROJECT_ID=
# DURABLE_ACTORS_SECRET=
# TERSE_ACTOR_URL=
# TERSE_API_KEY=

# --- Server ---
# PORT=3300
# production = serve web/dist (build it first); unset = Vite middleware with HMR.
# NODE_ENV=production

# --- dev.sh port overrides (lane testing only) ---
# ACTORS_PORT=7300
# SERVER_PORT=3300
